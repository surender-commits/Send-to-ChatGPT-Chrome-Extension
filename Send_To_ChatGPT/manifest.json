{
   "manifest_version": 3,
   "name": "Send_To_ChatGPT",
   "version": "1.1.0",
   "description": "Select text and send it directly to ChatGPT.",
   "permissions": [
      "storage",
      "tabs",
      "activeTab",
      "scripting"
   ],
   "host_permissions": [
      "<all_urls>",
      "https://chatgpt.com/*"
   ],
   "background": {
      "service_worker": "background.js"
   },
   "action": {   
      "default_title": "Click to set active ChatGPT tab as receiver"
   },
   "icons": {
      "16": "icon.png",
      "32": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
   },
   "content_scripts": [
      {
         "matches": [
            "<all_urls>"
         ],
         "js": [
            "content_universal.js"
         ],
         "run_at": "document_idle"
      },
      {
         "matches": [
            "https://chatgpt.com/*"
         ],
         "js": [
            "content_chatgpt.js"
         ],
         "run_at": "document_idle"
      }
   ]
}